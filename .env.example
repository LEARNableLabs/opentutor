# ── LLM Backend ──────────────────────────────────────────────
# Options: claude-sdk, cli, openai, openrouter, ollama
OPENTUTOR_LLM=claude-sdk
ANTHROPIC_API_KEY=

# Pipeline can use a different (faster) backend
# OPENTUTOR_PIPELINE_LLM=claude-sdk

# ── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Optional: restrict bot to one chat
# TELEGRAM_CHAT_ID=

# ── Supabase (production database) ───────────────────────────
# When set, replaces SQLite with Supabase Postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (email notifications) ─────────────────────────────
RESEND_API_KEY=
RESEND_FROM=OpenTutor <tutor@opentutor.dev>
# RESEND_TO=student@example.com

# ── OpenRouter (alternative LLM — 200+ models) ──────────────
# OPENROUTER_API_KEY=
# OPENROUTER_STRONG_MODEL=anthropic/claude-sonnet-4-20250514
# OPENROUTER_CHEAP_MODEL=anthropic/claude-haiku-4-5-20251001

# ── OpenAI (alternative LLM) ────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_STRONG_MODEL=gpt-4o
# OPENAI_CHEAP_MODEL=gpt-4o-mini

# ── Ollama (local models) ───────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_STRONG_MODEL=llama3.1:70b
# OLLAMA_CHEAP_MODEL=llama3.2

# ── Local Dev ────────────────────────────────────────────────
OPENTUTOR_PORT=3000
# Isolate test data: OPENTUTOR_DATA_DIR=.test-data

# ── Schedule ─────────────────────────────────────────────────
# SCHEDULE_TIMES=09:00,13:00,19:00
# SCHEDULE_TZ=America/New_York
