# ── LLM Backend ──────────────────────────────────────────────
# Options: claude-sdk, cli, openai, openrouter, ollama
# Used by the web server, the Vercel routes and the curriculum pipeline.
OPENTUTOR_LLM=claude-sdk
ANTHROPIC_API_KEY=

# Pipeline can use a different (faster) backend
# OPENTUTOR_PIPELINE_LLM=claude-sdk

# NOTE: the Telegram bot's chat and lesson calls do NOT read OPENTUTOR_LLM yet —
# they read CLAUDE_BACKEND below. See issue #98.
# CLAUDE_BACKEND=sdk          # 'sdk' (Anthropic API) or 'cli' (Claude Code CLI, default)
# CLAUDE_PIPELINE_BACKEND=sdk
# CLAUDE_STRONG_MODEL=claude-sonnet-4-20250514
# CLAUDE_CHEAP_MODEL=claude-haiku-4-5-20251001

# ── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Restricts the bot to one chat. Also REQUIRED for scheduled daily lessons —
# without it the scheduler runs but delivers nothing (scripts/bot/scheduler.js).
# TELEGRAM_CHAT_ID=
# Telegram runs separately with npm run bot on an always-on host.
# Vercel hosts the web version only; do not set Telegram credentials there.

# ── Supabase (production database) ───────────────────────────
# When set, replaces SQLite with Supabase Postgres.
# Apply every migration in supabase/migrations/ in numeric order.
SUPABASE_URL=
# Dashboard → Settings → API Keys. Use the secret key (sb_secret_…), which replaces
# the legacy service_role JWT. Either variable name works; both bypass RLS, so this
# is server-side only — never ship it to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=


# ── OpenRouter (alternative LLM — 200+ models) ──────────────
# OPENROUTER_API_KEY=
# OpenRouter ids have NO date suffix — anthropic/claude-haiku-4.5, not …-4-5-20251001.
# OPENROUTER_STRONG_MODEL=anthropic/claude-sonnet-5
# OPENROUTER_CHEAP_MODEL=anthropic/claude-haiku-4.5
# Much cheaper alternative, verified to teach well (~13x less per lesson):
# OPENROUTER_STRONG_MODEL=deepseek/deepseek-v4.1-flash
# OPENROUTER_CHEAP_MODEL=deepseek/deepseek-v4.1-flash

# ── OpenAI (alternative LLM) ────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_STRONG_MODEL=gpt-4o
# OPENAI_CHEAP_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint (Codex, a local gateway, …)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Ollama (local models) ───────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_STRONG_MODEL=llama3.1:70b
# OLLAMA_CHEAP_MODEL=llama3.2

# ── Local Dev ────────────────────────────────────────────────
OPENTUTOR_PORT=3000
# OPENTUTOR_HOST=localhost
# Redirects runtime state (progress, completions, SQLite) to an isolated dir.
# Note: the bot also reads its curricula from <dir>/domains when this is set.
# OPENTUTOR_DATA_DIR=.test-data
# NODE_ENV=development        # 'production' switches the logger to JSON output

# ── Schedule ─────────────────────────────────────────────────
# SCHEDULE_TIMES=09:00,13:00,19:00
# SCHEDULE_TZ=America/New_York

# ── Web access ───────────────────────────────────────────────
# Required on Vercel. Use a separate secret for admin access.
# OPENTUTOR_PASSWORD=
# OPENTUTOR_ADMIN_PASSWORD=
