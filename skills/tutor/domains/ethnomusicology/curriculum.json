{
  "topic": "Ethnomusicology — music across cultures",
  "slug": "ethnomusicology",
  "created": "2026-08-21",
  "student_level": "intermediate",
  "prerequisites": [
    "basic music theory (notation, scales, rhythm)",
    "familiarity with Western music history",
    "cultural anthropology basics (helpful but not required)"
  ],
  "exit_criteria": [
    "analyze music from diverse cultures using appropriate theoretical frameworks",
    "identify and describe musical elements beyond Western notation (tuning systems, rhythmic patterns, timbres)",
    "critically evaluate ethnomusicological research through emic and etic lenses",
    "understand ethical considerations in music research and cultural representation",
    "conduct basic fieldwork documentation (recording, interviewing, transcription)",
    "engage with contemporary debates in ethnomusicology (appropriation, preservation, globalization)"
  ],
