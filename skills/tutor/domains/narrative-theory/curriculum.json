{
  "topic": "Narrative Theory — How Stories Work",
  "slug": "narrative-theory",
  "created": "2026-08-21",
  "student_level": "intermediate",
  "prerequisites": [
    "close reading skills",
    "familiarity with literary/film analysis",
    "basic understanding of semiotics or structuralism (helpful but not required)"
  ],
  "exit_criteria": [
    "distinguish between story (fabula) and discourse (syuzhet) in any narrative",
    "identify and analyze focalization, narrative voice, and narrative levels",
    "map narrative time manipulations (analepsis, prolepsis, duration, frequency)",
    "apply Genette's narratological framework to literary and non-literary texts",
    "recognize and categorize character functions using actantial models",
    "analyze how narrative structure shapes audience interpretation",
    "apply narrative theory to transmedia storytelling (film, games, serial formats)",
    "articulate the differences between classical and postclassical narratology"
  ],
