{
  "name": "opentutor",
  "version": "1.0.0",
  "description": "Portable AI tutor skill for any topic — works with Claude Code, Cursor, Gemini CLI, OpenCode, and any Agent Skills-compatible agent.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "opentutor": "./scripts/setup.js"
  },
  "files": [
    "lib/",
    "scripts/",
    "skills/",
    "workspace/",
    "openclaw/",
    "claude-code/",
    "claude-web/",
    "codex/"
  ],
  "scripts": {
    "bot": "node scripts/bot/index.js",
    "bot:dev": "node --watch scripts/bot/index.js",
    "bot:test": "OPENTUTOR_DATA_DIR=.test-data node scripts/bot/index.js",
    "web": "node scripts/web/server.js",
    "web:dev": "node --watch scripts/web/server.js",
    "web:test": "OPENTUTOR_DATA_DIR=.test-data node scripts/web/server.js",
    "lint": "eslint scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "node-cron": "4.2.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
