{
  "name": "opentutor",
  "version": "1.0.0",
  "description": "Portable AI tutor skill for any topic \u2014 works with Claude Code, Cursor, Gemini CLI, OpenCode, and any Agent Skills-compatible agent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LEARNableLabs/opentutor.git"
  },
  "homepage": "https://github.com/LEARNableLabs/opentutor#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "opentutor": "./scripts/setup.js"
  },
  "files": [
    "lib/",
    "scripts/",
    "skills/",
    "workspace/AGENTS.md",
    "workspace/IDENTITY.md",
    "workspace/SOUL.md",
    "workspace/USER.md",
    "workspace/tutor/progress.json",
    "api/",
    "public/",
    "assets/",
    "supabase/",
    "openclaw/",
    "hermes/",
    "claude-code/",
    "claude-web/",
    "codex/",
    "nanoclaw/",
    "nemoclaw/",
    "vercel.json"
  ],
  "scripts": {
    "bot": "node scripts/bot/index.js",
    "bot:dev": "node --watch scripts/bot/index.js",
    "bot:test": "OPENTUTOR_DATA_DIR=.test-data node scripts/bot/index.js",
    "web": "node scripts/web/server.js",
    "web:dev": "node --watch scripts/web/server.js",
    "web:test": "OPENTUTOR_DATA_DIR=.test-data node scripts/web/server.js",
    "lint": "eslint lib scripts api",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@supabase/supabase-js": "^2.112.4",
    "better-sqlite3": "^13.0.3",
    "node-cron": "4.2.1",
    "pino": "^10.3.1",
    "resend": "^6.25.0"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "pino-pretty": "^13.1.3",
    "vitest": "^4.1.11"
  }
}
