{
  "framework": null,
  "functions": {
    "api/build-topic.js": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "opentutor-curriculum"
        }
      ]
    },
    "api/catalog.js": {
      "maxDuration": 60,
      "includeFiles": "skills/tutor/domains/*/curriculum.json"
    },
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/openrouter",
      "destination": "/api/account?via=openrouter"
    },
    {
      "source": "/api/demo",
      "destination": "/api/catalog?via=demo"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "regions": [
    "iad1"
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
